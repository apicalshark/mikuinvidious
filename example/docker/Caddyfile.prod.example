{
    # Disable HTTP/3 (QUIC) due to range request / 206 Partial Content issues on media proxies
    servers {
        protocols h1 h2
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 30MiB
            roll_keep 5
        }
        format json
    }

    email your@email
    acme_ca URL
    acme_eab {
        key_id ID
        mac_key MAC_KEY
    }
}

yourdomain {
    tls {
        curves x25519mlkem768 x25519 secp256r1
        key_type p384
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 30MiB
            roll_keep 5
        }
        format json
    }

    request_body {
        max_size 1MB
    }

    root * /usr/share/caddy
    header {
        -Server
        -Via
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle /static/* {
    	header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    	header Cross-Origin-Resource-Policy "same-origin"
    	header Cache-Control "public, max-age=86400"
    	reverse_proxy app:8080 {
        	header_up Host {host}
        	header_up X-Real-IP {remote_host}
        	header_up X-Forwarded-For {remote_host}
        	header_up X-Forwarded-Proto {scheme}
    	}
    }

	handle /site.webmanifest {
    	header Content-Type "application/manifest+json"
    	header Cross-Origin-Resource-Policy "same-origin"
    	header Cache-Control "public, max-age=86400"
    	reverse_proxy app:8080 {
        	header_up Host {host}
        	header_up X-Real-IP {remote_host}
        	header_up X-Forwarded-For {remote_host}
        	header_up X-Forwarded-Proto {scheme}
    	}
    }

    @notProxy not path /proxy/*
    encode @notProxy zstd gzip

    handle /proxy/pic/* {
        reverse_proxy anubis:8923 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy anubis:8923 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
