# MicroWARP (Cloudflare WARP SOCKS5) + gost HTTP bridge.
#
# Optional egress for MikuInvidious. Needed only on datacenter /
# risk-controlled IPs (Bilibili HTTP 412 / -352); residential links can
# run direct with HTTP_PROXY left empty.
#
# Usage:
#   cp compose.yml.example compose.yml
#   docker compose up -d
#
# Endpoints (verified Oct 2026, microwarp 0.3.1):
#   SOCKS5  127.0.0.1:1080  (microwarp, kernel WireGuard WARP tunnel)
#   HTTP    127.0.0.1:1081  (gost CONNECT bridge in front of :1080)
#
# The app speaks SOCKS5 natively (CdnConnection handshake for media +
# libcurl transport for API calls), so the gost HTTP bridge is OPTIONAL —
# just a convenience for HTTP-proxy-only clients.
#
# Access:
#   - From the host itself: 127.0.0.1:1080 (SOCKS5) / 127.0.0.1:1081 (HTTP).
#   - From Docker containers (recommended): attach microwarp and the app to a
#     shared Docker network (no host port exposure needed) and set:
#       HTTP_PROXY=socks5://microwarp:1080
#     If another container needs the gost HTTP bridge instead, place
#     microwarp-http on that same shared network (remove `network_mode: host`),
#     change its command to `-L=http://:1081 -F=socks5://microwarp:1080`, and
#     set `HTTP_PROXY=http://microwarp_http:1081`.
#
# Auth: MicroWARP >=0.3 refuses to start an unauthenticated proxy unless
# ALLOW_NO_AUTH=1 is set (see below). For authenticated mode instead:
#   environment:
#     - SOCKS_USER=...
#     - SOCKS_PASS=...
# drop ALLOW_NO_AUTH, and point clients at socks5://user:pass@microwarp:1080.
# Both host ports below are bound to 127.0.0.1 so an unauthenticated proxy is
# never exposed to the public internet or LAN.

services:
  microwarp:
    image: ghcr.io/ccbkkb/microwarp:latest
    container_name: microwarp
    restart: always
    ports:
      - "127.0.0.1:1080:1080"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
    environment:
      - ALLOW_NO_AUTH=1
    volumes:
      - warp_data:/etc/wireguard

  # Optional: skip this service if the app uses SOCKS5 directly.
  # microwarp-http:
  #   image: gogost/gost:latest
  #   container_name: microwarp_http
  #   restart: always
  #   network_mode: host
  #   command: "-L=http://127.0.0.1:1081 -F=socks5://127.0.0.1:1080"
  #   depends_on:
  #     - microwarp

volumes:
  warp_data:
