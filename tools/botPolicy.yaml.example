bots:
  # Built-in Anubis defense definitions (bundled inside Anubis container image)
  - import: (data)/bots/_deny-pathological.yaml
  - import: (data)/bots/ai-robots-txt.yaml
  - import: (data)/bots/ai-catchall.yaml
  - import: (data)/bots/aggressive-brazilian-scrapers.yaml

  - import: (data)/common/acts-like-browser.yaml
  - import: (data)/common/domain-fronting.yaml
  - import: (data)/common/keep-internet-working.yaml
  - import: (data)/common/rfc-violations.yaml

  # Optional: dynamically synced VPS ASN snippet from tools/update_vps_asns.sh
  # - import: /data/cfg/vpsh_asns.yaml

  # HTTP method restrictions: MikuInvidious only accepts GET, HEAD, and POST
  - name: deny-unsupported-methods
    action: DENY
    expression: '!(method in ["GET", "HEAD", "POST"])'

  # Vulnerability scanners: drop exploit extensions instantly without processing
  - name: drop-exploit-extensions
    path_regex: (?i)\.(env|git|svn|bak|sql|tar|gz|zip|swp|php|asp|aspx|jsp|cgi)$
    action: DENY

  # Web probe paths: drop admin panel, CMS, and debug endpoint probes instantly
  - name: drop-probe-paths
    path_regex: (?i)^/(wp-admin|wp-login|xmlrpc\.php|phpmyadmin|actuator|console|cgi-bin|autodiscover|\.aws|id_rsa|telescope)
    action: DENY

  # Honeypot: drop automated crawlers that blindly follow hidden link traps
  - name: catch-honeypot
    path_regex: ^/(trap-hidden-bot-link|spider-trap|bot-trap).*$
    action: DENY

  # Empty UA is overwhelmingly scraper traffic
  - name: deny-empty-user-agent
    action: DENY
    expression: '!("User-Agent" in headers)'

  # Aggressive AI/data scrapers: hard deny
  - name: deny-bad-ai-crawlers
    user_agent_regex: (?i)(bytespider|claudebot|chatgpt-user|gptbot|ccbot|perplexitybot|petalbot|amazonbot|applebot-extended|cohere|diffbot|omgilibot|youbot|claude-)
    action: DENY

  # SEO crawlers: bandwidth thieves, no value
  - name: deny-seo-scrapers
    user_agent_regex: (?i)(mj12bot|ahrefsbot|semrushbot|dotbot|dataforseo|barkrowler|serpstat|blexbot|screaming)
    action: DENY

  # Scraping frameworks: hard PoW instead of deny (fewer false positives)
  - name: punish-scrape-frameworks
    user_agent_regex: (?i)(scrapy|scrapy-playwright|selenium|puppeteer|playwright|headlesschrome|phantomjs|slimerjs)
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 6
      report_as: 6

  # Scripting libs have no browser behind them: hard challenge
  - name: punish-script-libs
    user_agent_regex: (?i)(python-requests|python-httpx|^httpx|aiohttp|axios|node-fetch|node\.js|got/|curl|wget|libwww-perl|java/|go-http-client|okhttp|restsharp)
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 6
      report_as: 6

  # Spoofed Firefox via Chromium: User-Agent claims Firefox, but sends Chromium-exclusive Sec-Ch-Ua
  - name: catch-spoofed-firefox-chromium
    action: DENY
    expression: 'headers["User-Agent"].contains("Firefox/") && ("Sec-Ch-Ua" in headers || "sec-ch-ua" in headers)'

  # Missing Accept-Language header (standard browsers always send one; headless/scripts omit it)
  - name: weigh-missing-accept-language
    action: WEIGH
    expression: '!headers.exists(h, h.matches("(?i)accept-language"))'
    weight:
      adjust: 10

  # Spoofed Chrome: User-Agent claims Chrome, but lacks modern Sec-Ch-Ua client hint header
  - name: weigh-spoofed-chrome
    action: WEIGH
    expression: 'headers["User-Agent"].contains("Chrome/") && !("Sec-Ch-Ua" in headers)'
    weight:
      adjust: 15

  # Fake Firefox script: User-Agent claims Firefox, but lacks Sec-Fetch-Mode or Brotli (br) support
  - name: weigh-fake-firefox-script
    action: WEIGH
    expression: 'headers["User-Agent"].contains("Firefox/") && (!("Sec-Fetch-Mode" in headers) || !("Accept-Encoding" in headers) || !headers["Accept-Encoding"].contains("br"))'
    weight:
      adjust: 15

  # Non-standard engines: User-Agent is neither Chrome/Chromium nor Firefox
  - name: weigh-non-chrome-and-firefox
    action: WEIGH
    expression: '!headers["User-Agent"].matches("(?i)(chrome|crios|chromium|firefox|fxios)")'
    weight:
      adjust: 10

  # Known VPS, Datacenter, and Commercial VPN ASNs:
  # Grouped inline list with YAML anchor (&datacenter_asns) for reuse across rules.
  - name: weigh-datacenter-and-vpn-asns
    action: WEIGH
    asns:
      match: &datacenter_asns [
        # Hyperscalers: AWS, GCP, Azure, Oracle, etc (Cloudflare WARP 13335 & 209242 explicitly excluded)
        16509, 14618, 15169, 396982, 8075, 8068, 8069, 31898,
        # AWS additional infrastructure (NullifiedCode list)
        699, 801, 7224, 38895, 62785,
        # Major VPS & Cloud: DigitalOcean, Hetzner, OVH, Linode/Akamai, Vultr/Choopa, Scaleway, Leaseweb, Contabo
        14061, 24940, 213230, 16276, 35540, 63949, 20940, 20473, 12876, 16004, 16265, 60630, 28753, 51167, 40021,
        # DigitalOcean, Vultr, Hetzner, Contabo, Scaleway, Linode expanded pools
        39690, 62567, 133165, 135340, 200130, 201229, 202109, 205301, 393406, 394362, 11508, 46407, 133795, 212317, 141995, 29447, 54265, 48337,
        # Community & Budget VPS (Popular crawler & proxy endpoints): RackNerd, Bandwagon/IT7, DMIT, GreenCloud, SpartanHost, HostHatch, Time4VPS, xTom
        35916, 25820, 906, 32519, 132110, 202602, 50131, 201106, 63473, 212531, 3214, 9312,
        # Hosting / Dedicated / Colo: Hostinger, Netcup, IONOS, Rackspace, UpCloud, Kamatera, Serverius, Fastly, ColoCrossing, QuadraNet, Psychz, Clouvider, FDCservers, BuyVM, Tzulo, Selectel, G-Core, InMotion, MochaHost, A2Hosting, BlueHost, Scala
        47583, 197540, 8560, 19994, 27357, 202018, 35838, 50673, 54113, 36352, 8100, 40676, 62240, 30058, 53667, 11878, 49505, 202422, 204915, 51862, 23352, 6982, 55293, 46606, 263093, 40476,
        # Kamatera & InMotion Hosting additions
        36007, 41436, 54913, 204548, 210329, 396948, 396949, 64022, 54641, 38421, 226111,
        # European & Regional Hosting: Voxility, Strato, Worldstream, Melbicom, Cherry Servers, AlexHost, PQ Hosting, VDSina, Beget, Reg.ru, FirstVDS, MEVSPACE, DeinServerHost, RoyaleHosting, 100UP/Tube-Hosting, Floofy, EGI, GloboTech, ZGH
        3223, 6724, 49981, 28836, 8849, 56630, 213896, 204770, 200019, 43624, 44477, 48282, 216071, 198610, 197695, 49352, 29182, 201814, 213250, 212477, 49581, 212513, 210632, 18779, 36666, 263702,
        # US / Global Web & VPS Hosts: GoDaddy, Namecheap, DreamHost, Hostwinds, InterServer, Liquid Web
        26496, 22612, 26347, 54290, 19318, 32244, 53824, 21773, 135085, 6188, 22558, 40819, 201682,
        # GoDaddy expanded IP/ASN pool
        30083, 16892, 397513, 397514, 397515, 397516, 397517, 397518, 397519, 397520, 397521, 397522, 398101, 398102, 398103, 398104, 398105, 398106, 398107, 398108, 398109, 398110, 398785, 398786, 398787, 398788, 398789, 398790, 398791, 398792, 398793, 398794, 400746, 400747, 400748, 400749, 400750, 400751, 400752, 400753, 400754, 400755,
        # Specialty & Game VPS / Infrastructure: Nuclearfallout Enterprises (NFOservers) & HostRoyale Technologies
        14586, 32374, 32751, 214505, 393458, 400475, 401263, 203020, 35672, 39486, 46516, 133499, 134450, 204287, 396931,
        # Asia Cloud & VPS: Alibaba, Tencent, Huawei, Baidu, UCloud, Zenlayer, Sakura Internet, GMO/ConoHa
        45102, 37963, 132203, 45090, 136907, 55990, 38365, 135377, 21859, 137409, 9370, 7684, 7506,
        # Commercial VPN Infrastructure & Hosting: M247, DataCamp/CDN77, Latitude, Nord/Tefincom, PIA/Kape, Proton, Mullvad, Windscribe, StackPath/IPVanish, HideMyAss, Packethub, Cogent
        9009, 60068, 212238, 204601, 206092, 396356, 62371, 209103, 208585, 397423, 33438, 39351, 58061, 174,
        # Chinese Cross-Border / CN2 GIA / 9929 / CMIN2 / Community VPS (NodeSeek / Hostloc recommendations):
        # Misaka Network (US, JP, HK, EU)
        57695, 23961, 142616, 60000,
        # xTom / V.PS additional ASNs
        6233, 8888, 3258, 23858, 4785, 23959,
        # BandwagonHost / IT7 & DMIT additions
        21887, 54574,
        # CeraNetworks (CNSERVERS - major CN2 GIA / 9929 provider)
        40065,
        # VMISS & NetLab Global (LisaHost / VMISS)
        979, 967, 400464, 35251,
        # JINX, Prime Security & Shanghai Huajuan (花卷)
        150684, 140096, 131477, 400618,
        # WikiHost (微基主机 / 50KVM) additions
        139893, 215151,
        # KuaiCheDao (快车道) & Nube Cloud
        139046, 138997,
        # Akile Cloud & BageVM
        61112, 216174, 63150, 152913,
        # Sharon Networks & Hytron Network Services
        396856, 17433, 202662,
        # Kurun Cloud / FastNet Data & ByteVirt / Krypt / VPLS
        8796, 139637, 214300, 35908,
        # Kirino LLC (CloudSilk/白丝云 upstream) & Nearoute (CoalCloud/炭云 HK)
        41378, 51847,
        # TechAvenue / GigsGigsCloud additions & ZGOCloud & WAP CC & DigitalVirt & Dogyun / XNNET
        63916, 55799, 197767, 198100, 11161, 932,
        # Regional Outbound & Optimize VPS: MOACK (Korea), Skyline Connect (SG), TotHost (Vietnam), Evoxt, Sakura Link, Catixs, Akari
        138195, 216211, 151873, 149440, 49304, 9516, 48266, 983,
        # MJJ Community Outbound & Transit Nodes: Spike Telecom, BGPNET, Starry, Landui, V5.NET, VKVM, Lumity, Alvidi, RackSmart, PEG TEC, PITTQIAO, Awesomecloud, AROSS, Landups, Cloudfort, VH Global, Cgi Global, Megaplayer, Cloudie/YunYoo
        60504, 141883, 64050, 134835, 134365, 6134, 215269, 140896, 18464, 399195, 398993, 54600, 131642, 151487, 400619, 150452, 7586, 42960, 56971, 139646, 55933,
        # US Budget / Niche Hosts popular in Chinese proxy tutorials: HostUS, ExtraVM, Crunchbits, IncogNET, Atlantic.Net, ServerPoint, PureVoltage, RamNode, FiberState
        7489, 53724, 400304, 40663, 6364, 26277, 26548, 3842, 26042,
        # Chinese Internet Censorship, Surveillance, DPI & Research Institutes:
        # Geedge Networks (Tiangou Secure Gateway DPI / GFW exporter - leaked Sep 2025)
        141021,
        # CSTNET / Chinese Academy of Sciences (CAS / 中科院计算机网络信息中心 / MESA Lab)
        7497, 132801, 134079,
        # CERNET & CERNET2 (China Education and Research Network / GFW origin and testing testbed)
        4538, 23910, 23911, 24354,
        # CNNIC (China Internet Network Information Center / 国家互联网络信息中心 / SDNS)
        24424, 38803, 18244, 4221, 24151,
        # CNCERT / CC (National Computer Network Emergency Response / 态势感知与全网扫描)
        58543,
        # Sangfor Technologies (深信服科技 - SSL Inspection / DPI / Enterprise Firewall Exporter)
        151662,
        # Qihoo 360 (奇虎360 - Active Scanning, Vulnerability Research & Intelligence)
        55992, 55994, 55995, 137725,
        # NSFOCUS (绿盟科技) & Venustech (启明星辰)
        137775, 137776, 138421,
        # Great Wall Broadband / Dr. Peng (长城宽带 / 鹏博士 - aggressive MITM cache injection & hijacking)
        17964, 9801,
        # Chinese Major IT & Internet Tech Companies (incl. Bilibili):
        # Bilibili (BILIBILI HK LIMITED / 上海幻电)
        140633,
        # ByteDance / TikTok / Douyin (字节跳动)
        396986, 138699, 137718, 149303,
        # NetEase (网易)
        45062, 137263, 131659,
        # JD.com (京东 / 京东云)
        58519, 137714, 137715, 138158,
        # Kuaishou (快手)
        139090, 138696, 137726,
        # Meituan (美团) & Xiaomi (小米)
        136960, 136961, 137728, 138402,
        # Sina / Weibo (新浪 / 微博) & Xiaohongshu (小红书 / 行吟信息科技)
        4808, 58563, 151282,
        # Kingsoft Cloud (金山云)
        135384, 135385, 135386, 135387,
        # Alibaba / Taobao & Tencent & Baidu infrastructure additions
        24429, 59067, 137720, 132591, 133475, 136908, 55967, 138698
      ]
    weight:
      adjust: 15

  # Escalated Geos: BRICS, HK/MO, Central Asia, Middle East, South & Central America (incl. Mexico), and all Africa:
  # Grouped inline list with YAML anchor (&targeted_geos) for reuse across rules.
  - name: weigh-targeted-geos
    action: WEIGH
    geoip:
      countries: &targeted_geos [
        # Greater China SARs & Eurasia:
        HK, MO, CN, RU, IN, VN, ID, BD, PK, PH, TH, TR, UA,
        # Central Asia:
        KZ, UZ, KG, TJ, TM,
        # Middle East:
        SA, AE, IR, IQ, SY, YE, OM, QA, KW, BH, JO, LB, IL, PS,
        # Mexico & Central America:
        MX, GT, BZ, SV, HN, NI, CR, PA,
        # South America:
        BR, AR, CO, CL, PE, VE, EC, BO, PY, UY, GY, SR,
        # North Africa:
        EG, DZ, MA, TN, LY, SD, SS,
        # West Africa:
        NG, GH, CI, SN, ML, BF, NE, GN, BJ, TG, SL, LR, MR, GM, GW, CV,
        # Central Africa:
        CD, CG, CM, GA, GQ, CF, TD, ST, AO,
        # East Africa:
        ET, KE, UG, TZ, RW, BI, SO, DJ, ER, MG, MU, KM, SC,
        # Southern Africa:
        ZA, ZM, ZW, MZ, NA, BW, MW, LS, SZ
      ]
    weight:
      adjust: 10

  # Public JSON API (/space/.../json): Must work for RSS/scripts without JS,
  # but strictly gated against abuse from datacenter IPs, VPNs, and high-risk regions:
  - name: challenge-space-json-datacenter
    action: CHALLENGE
    expression: 'path.startsWith("/space/") && path.endsWith("/json")'
    asns:
      match: *datacenter_asns
    challenge:
      algorithm: fast
      difficulty: 6
      report_as: 6

  - name: challenge-space-json-geos
    action: CHALLENGE
    expression: 'path.startsWith("/space/") && path.endsWith("/json")'
    geoip:
      countries: *targeted_geos
    challenge:
      algorithm: fast
      difficulty: 6
      report_as: 6

  # Clean residential traffic: allowed freely without JS challenge
  - name: allow-space-json
    action: ALLOW
    expression: 'path.startsWith("/space/") && path.endsWith("/json")'

  # Verified crawlers only (UA + IP pin, never UA alone). Opt-in.
  # - name: allow-qwantbot
  #   user_agent_regex: \+https\://help\.qwant\.com/bot/
  #   action: ALLOW
  #   remote_addresses: ["91.242.162.0/24"]

  # Under load, make new sessions prove themselves harder (tune to ~2x cores)
  - name: high-load-shed
    action: WEIGH
    expression: 'load_1m >= 8.0'
    weight:
      adjust: 20

# Evaluates the client's final accumulated weight from the WEIGH rules above.
# Explicit ALLOW / DENY / CHALLENGE rules in 'bots' take precedence.
thresholds:
  - name: baseline
    # Clean residential client (weight <= 0): baseline challenge (keeps media behind PoW).
    # (To allow clean residential traffic through without challenge, set action to ALLOW).
    expression: 'weight <= 0'
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 4
      report_as: 4

  - name: mild-suspicion
    # Targeted regional traffic (weight 1-14, e.g. weigh-targeted-geos +10)
    expression: 'weight > 0 && weight < 15'
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 6
      report_as: 6

  - name: moderate-suspicion
    # Datacenter / VPS / VPN traffic (weight 15-24, e.g. weigh-datacenter-and-vpn-asns +15)
    expression: 'weight >= 15 && weight < 25'
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 7
      report_as: 7

  - name: high-suspicion
    # Compounded risk (weight 25-34, e.g. Datacenter ASN + Targeted Geo = +25)
    expression: 'weight >= 25 && weight < 35'
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 8
      report_as: 8

  - name: extreme-suspicion
    # Severe suspicion (weight >= 35, e.g. Datacenter IP + High Load or Fake Chrome + Proxy):
    # Computational tarpit: burns attacker CPU cores on heavy cryptographic Proof-of-Work
    expression: 'weight >= 35'
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 10
      report_as: 10


# Production store (default memory backend is not for production):
# store:
#   backend: valkey
#   parameters:
#     URL: "redis://redis:6379/1"

# Metrics (bind localhost only, debug routes leak process details):
# metrics:
#   bind: "127.0.0.1:9090"
#   network: tcp

# Logging (optional: set asn: true to tag request logs with client ASN)
# logging:
#   sink: stdio
#   asn: true

# GeoIP databases (required for 'geoip' and 'asns' rules above):
# Mount databases from host or configure auto_update if you have a MaxMind license.
geoip:
  asn:
    path: /var/lib/GeoIP/GeoLite2-ASN.mmdb
  country:
    path: /var/lib/GeoIP/GeoLite2-Country.mmdb
  # Optional automatic updates:
  # auto_update:
  #   account_id: 123456
  #   license_key_env: MAXMIND_LICENSE_KEY
  #   interval: 24h

