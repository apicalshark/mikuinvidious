{
    # You should disable HTTP/3 (QUIC) due to persistent ERR_QUIC_PROTOCOL_ERROR on 206 Partial Content
    # responses when proxying Bilibili media streams. Modern browsers' QUIC stacks
    # are sensitive to stream truncation and range request handling in proxies.
    # servers {
    #    protocols h1 h2
    # }
}

:8000 {
    root * /usr/share/caddy

    log {
        output stdout
        format json
    }

    request_body {
        max_size 1MB
    }

    header -Server

    handle /static/* {
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "strict-origin-when-cross-origin"
        header Permissions-Policy "camera=(), microphone=(), geolocation=()"
        header Cross-Origin-Resource-Policy "same-origin"
        file_server
    }
    handle /site.webmanifest {
        root * /usr/share/caddy/static
        header Content-Type "application/manifest+json"
        header X-Content-Type-Options "nosniff"
        header Cross-Origin-Resource-Policy "same-origin"
        file_server
    }

    @notProxy not path /proxy/*
    encode @notProxy zstd gzip

    # Provide your own cert and private key
    # tls /path/to/cert.pem /path/to/key.pem

    handle {
        reverse_proxy app:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
}
